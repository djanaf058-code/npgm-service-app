# Copy this file to app/.env.local and fill in real values.
# (.env.local must live next to package.json — i.e. inside app/)
# .env.local is gitignored — secrets MUST stay local.

# ============================================================
# Supabase
# ============================================================

# Public URL of your Supabase project (safe to expose)
# Find at: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon (publishable) key — safe to expose; protected by RLS
# Find at: Supabase Dashboard → Project Settings → API → Project API keys → "anon" / "publishable"
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service role key (NEVER expose to frontend; backend only)
# Get from: Supabase Dashboard → Project Settings → API → service_role
# !!! ROTATE IF EVER LEAKED !!!
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Cohere (embedding for semantic search of manuals)
# ============================================================

# Get from https://dashboard.cohere.com/api-keys (free trial gives $5)
COHERE_API_KEY=co_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Claude (NOT used in MVP — added in Sprint 5 post-MVP)
# ============================================================

# When AI auto-replies are enabled, set hard spending cap to $50/mo
# in https://console.anthropic.com/settings/limits
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# App configuration
# ============================================================

# Base URL of frontend (for callbacks, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default language for new users
NEXT_PUBLIC_DEFAULT_LOCALE=ru
